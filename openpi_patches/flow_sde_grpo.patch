index ae7c459..c8aa795 100644
--- a/src/openpi/models/pi0.py
+++ b/src/openpi/models/pi0.py
@@ -277,3 +277,104 @@ class Pi0(_model.BaseModel):
 
         x_0, _ = jax.lax.while_loop(cond, step, (noise, 1.0))
         return x_0
+
+    def sample_actions_with_logprob(
+        self,
+        rng: at.KeyArrayLike,
+        observation: _model.Observation,
+        *,
+        num_steps: int = 10,
+        noise_level: float = 0.7,
+        sde_type: str = "cps",
+        noise: at.Float[at.Array, "b ah ad"] | None = None,
+    ):
+        """Flow-SDE sampling for on-policy RL (Flow-GRPO). HOOK A.
+
+        Same forward pass as sample_actions, but the deterministic Euler step is
+        replaced by the marginal-preserving SDE step (openpi.models.flow_sde), so the
+        action becomes a stochastic sample with a tractable per-step log-prob.
+
+        Returns (action, chain, step_logp):
+          action    : x_0                       (b, ah, ad)
+          chain     : (num_steps+1, b, ah, ad)  denoising latent trajectory
+          step_logp : (num_steps, b)            per-step logp under the sampling policy
+        num_steps must be a static Python int (the SDE loop uses lax.scan).
+        SANITY: noise_level=0 reproduces the deterministic sample_actions output.
+        """
+        from openpi.models import flow_sde as _fsde
+
+        observation = _model.preprocess_observation(None, observation, train=False)
+        batch_size = observation.state.shape[0]
+        if noise is None:
+            noise = jax.random.normal(rng, (batch_size, self.action_horizon, self.action_dim))
+
+        velocity_fn = self._build_flow_velocity_fn(observation)
+        sigmas = _fsde.make_sigmas(num_steps)
+        out = _fsde.flow_sde_sample(velocity_fn, noise, sigmas, noise_level, rng, sde_type=sde_type)
+        return out["action"], out["chain"], out["step_logp"]
+
+    def _build_flow_velocity_fn(self, observation: _model.Observation):
+        """Shared velocity closure for the flow-SDE sampler and logp recompute.
+
+        Fills the KV cache with a prefix forward pass (identical to sample_actions),
+        then returns velocity_fn(x_t, time) = the model's action-head output — the body
+        of the deterministic `step` minus the Euler update. `observation` must already
+        be preprocessed (preprocess_observation).
+        """
+        batch_size = observation.state.shape[0]
+        prefix_tokens, prefix_mask, prefix_ar_mask = self.embed_prefix(observation)
+        prefix_attn_mask = make_attn_mask(prefix_mask, prefix_ar_mask)
+        positions = jnp.cumsum(prefix_mask, axis=1) - 1
+        _, kv_cache = self.PaliGemma.llm([prefix_tokens, None], mask=prefix_attn_mask, positions=positions)
+
+        def velocity_fn(x_t, time):
+            suffix_tokens, suffix_mask, suffix_ar_mask, adarms_cond = self.embed_suffix(
+                observation, x_t, jnp.broadcast_to(time, batch_size)
+            )
+            suffix_attn_mask = make_attn_mask(suffix_mask, suffix_ar_mask)
+            prefix_attn_mask_s = einops.repeat(prefix_mask, "b p -> b s p", s=suffix_tokens.shape[1])
+            full_attn_mask = jnp.concatenate([prefix_attn_mask_s, suffix_attn_mask], axis=-1)
+            pos = jnp.sum(prefix_mask, axis=-1)[:, None] + jnp.cumsum(suffix_mask, axis=-1) - 1
+            (prefix_out, suffix_out), _ = self.PaliGemma.llm(
+                [None, suffix_tokens], mask=full_attn_mask, positions=pos,
+                kv_cache=kv_cache, adarms_cond=[None, adarms_cond],
+            )
+            assert prefix_out is None
+            return self.action_out_proj(suffix_out[:, -self.action_horizon :])
+
+        return velocity_fn
+
+    def compute_chain_logp(
+        self,
+        observation: _model.Observation,
+        chain: at.Float[at.Array, "s b ah ad"],
+        *,
+        noise_level: float = 0.7,
+        sde_type: str = "cps",
+        remat: bool = True,
+    ) -> at.Float[at.Array, "num_steps b"]:
+        """Per-step logp of a RECORDED denoising chain under the CURRENT policy. HOOK C.
+
+        This is the training-side counterpart of sample_actions_with_logprob: given the
+        chain the sampling policy produced, recompute each step's Gaussian log-prob under
+        the (updated) model. With the current policy == the sampling policy this exactly
+        reproduces step_logp (on-policy ratio ≡ 1). The GRPO loss forms
+        exp(logp_new - logp_old) from this.
+
+        chain: (num_steps+1, b, ah, ad) — leading axis is the denoising step, matching
+        flow_sde_sample's output. Returns (num_steps, b).
+
+        remat=True (default) wraps the per-step velocity in jax.checkpoint so the backward
+        pass recomputes each denoising step's forward instead of storing all of them — cuts
+        activation memory ~num_steps× (needed to fit the GRPO backward on a 24GB GPU) at ~2×
+        compute. Numerically identical, so the on-policy ratio is unchanged.
+        """
+        from openpi.models import flow_sde as _fsde
+
+        observation = _model.preprocess_observation(None, observation, train=False)
+        velocity_fn = self._build_flow_velocity_fn(observation)
+        if remat:
+            velocity_fn = jax.checkpoint(velocity_fn)   # rematerialize forward in backward
+        num_steps = chain.shape[0] - 1
+        sigmas = _fsde.make_sigmas(num_steps)
+        return _fsde.flow_sde_recompute_logp(velocity_fn, chain, sigmas, noise_level, sde_type=sde_type)
